# Copy to .env and fill in. .env is git-ignored; never commit it.

# Supabase: Project -> Connect -> "Session pooler" connection string, with your DB password filled in.
# Any Postgres 13+ works too, e.g. postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# From https://app.theirstack.com (Settings -> API Key). Comma-separate several keys to
# rotate to the next one when a key runs out of credits.
THEIRSTACK_API_KEYS=

# Optional: use a different searches file.
# SEARCHES_FILE=searches.toml

# Optional, Prefect deploy only: token for cloning a private repo.
# JOBSEEKER_GIT_TOKEN=
